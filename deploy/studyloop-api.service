[Unit]
Description=StudyLoop API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=weiyu
Group=weiyu
WorkingDirectory=/srv/studyloop/app/backend
EnvironmentFile=/etc/studyloop/backend.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/studyloop/venv/bin/uvicorn studyloop.main:app --app-dir src --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/studyloop/data/avatars

[Install]
WantedBy=multi-user.target
