# Copy to backend/.env for local development; supply an existing PostgreSQL connection.
# No credentials are shipped with the application.
DATABASE_URL=
CORS_ORIGINS=https://njuywy.github.io,http://localhost:5173,http://127.0.0.1:5173
AVATAR_DIRECTORY=/srv/studyloop/data/avatars
# SMTP credentials stay exclusively on the backend. TLS: starttls (587) or ssl (465).
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT=5
PAGES_URL=https://njuywy.github.io/StudyLoop/
# Requests per client IP in a 10-minute window; resend also enforces 60s per email.
REGISTER_LIMIT=10
RESEND_LIMIT=20
LOGIN_LIMIT=10
